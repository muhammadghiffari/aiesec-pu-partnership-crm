# .env.example — placeholder values ONLY. Never put real secrets here.
# Copy to .env.local and fill in; .env* files must never be committed.
# Validation contract: packages/config (M0-04). Startup fails safely when a
# required value is missing, malformed or still a placeholder; error messages
# name the VARIABLE only, never its value.
#
# Coding-agent note: model names chosen for IDE/agent tools (GLM, Claude, ...)
# are developer-tool settings and deliberately have NO variable here. The
# LLM_* variables configure the APPLICATION runtime provider only.

# --- App runtime ---
NODE_ENV=development
APP_URL=http://localhost:3000
TZ=Asia/Jakarta

# --- Database ---
# Development default when unset: postgres://localhost:5432/aiesec_crm_dev
DATABASE_URL=

# --- Auth (Google OAuth + server-side allowlist) ---
# Enabled implicitly by setting AUTH_SECRET/AUTH_GOOGLE_ID; mandatory in production.
ALLOWED_EMAILS=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- LLM adapter (application runtime) ---
AI_ENABLED=false
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_DEFAULT=
LLM_MODEL_QUALITY=
LLM_TIMEOUT_MS=45000
LLM_MAX_OUTPUT_TOKENS=2000
LLM_MAX_CONCURRENCY=1

# --- Worker ---
WORKER_MAX_MINUTES=20

# --- Safety flags (must stay false in production without an approved decision) ---
OUTBOUND_ASSISTED_SEND_ENABLED=false
COMPANION_ENABLED=false

# --- Worker dispatch / integrations ---
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=muhammadghiffari/aiesec-pu-partnership-crm
SEARCH_PROVIDER=none
SEARCH_API_KEY=
ENRICH_PROVIDER=none
ENRICH_API_KEY=

# --- Fixed official values / policy ---
ESSM_SURVEY_URL=https://s.aiesec.or.id/AIESECPartnershipSurvey-BD
TRANSCRIPT_RETENTION_DAYS=30
BACKUP_AGE_PUBLIC_KEY=
