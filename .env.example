# Do not store real values here. Runtime provider is chosen only after a separate smoke/evaluation.
NODE_ENV=development
APP_URL=http://localhost:3000
TZ=Asia/Jakarta
DATABASE_URL=
# Optional: disable | require | verify-full. An explicit sslmode in DATABASE_URL also works.
DATABASE_SSL=
# Google Identity Services public client ID. The ID-token flow needs no client secret.
GOOGLE_OAUTH_CLIENT_ID=
# Exact allowlisted emails, separated by comma, semicolon or newline.
CRM_ALLOWED_EMAILS=
AI_ENABLED=false
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_DEFAULT=
LLM_MODEL_QUALITY=
LLM_TIMEOUT_MS=45000
LLM_MAX_OUTPUT_TOKENS=2000
LLM_MAX_CONCURRENCY=1
WORKER_MAX_MINUTES=20
OUTBOUND_ASSISTED_SEND_ENABLED=false
COMPANION_ENABLED=false
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=muhammadghiffari/aiesec-pu-partnership-crm
SEARCH_PROVIDER=none
SEARCH_API_KEY=
ENRICH_PROVIDER=none
ENRICH_API_KEY=
ESSM_SURVEY_URL=https://s.aiesec.or.id/AIESECPartnershipSurvey-BD
TRANSCRIPT_RETENTION_DAYS=30
BACKUP_AGE_PUBLIC_KEY=
